# Legawa — HF Space environment variables
# Copy to .env and fill in your values.

# --- LLM BIG (sintesis, drafting) ---
# Default: Hugging Face Inference API (Qwen3.6-27B)
LLM_BIG_URL=https://api-inference.huggingface.co/models/Qwen/Qwen3.6-27B/v1
LLM_BIG_API_KEY=
LLM_BIG_MODEL=qwen3

# --- LLM SMALL (klasifikasi, ekstraksi) ---
# Default: Hugging Face Inference API (Qwen3.6-35B-A3B)
LLM_SMALL_URL=https://api-inference.huggingface.co/models/Qwen/Qwen3.6-35B-A3B/v1
LLM_SMALL_API_KEY=
LLM_SMALL_MODEL=qwen3

# --- pasal.id ---
# Dapatkan token di https://pasal.id
PASAL_API_TOKEN=
PASAL_BASE_URL=https://pasal.id/api/v1

# --- LLM defaults ---
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# --- Legawa settings ---
LEGAWA_STRICT_CITATIONS=1
